# Copy this file to .env.local and fill in real values from the Supabase
# dashboard (Project Settings -> API) for the shared "master_db" project
# (hmkjszolqnpcsoatrgcu). Only needed for app/api/pings/* — the rest of
# the app is still a client-only/localStorage prototype. Never commit
# .env.local — it's gitignored.

NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser. Used by
# lib/supabase-client.ts (the /login, /signup pages' supabase.auth.*
# calls). Supabase dashboard -> Project Settings -> API -> anon/public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the
# client. Used by lib/supabase-server.ts (app/api/pings/* route handlers)
# since this design has no per-user auth/RLS to rely on (see
# server/schema.sql's header) — the route handlers are the access-control
# layer instead.
# Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Set these on Vercel too (Project Settings -> Environment Variables),
# not just locally.

# Web Push (app/api/push/*, app/line-status's "Notify me" toggle). A
# VAPID key pair identifies this server to browsers' push services —
# generate your own with `npx web-push generate-vapid-keys`, don't reuse
# someone else's. Public key is safe to expose (used by
# lib/push-notifications.ts to call pushManager.subscribe()); the
# private key signs push payloads server-side and must never reach the
# browser bundle.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI web-push's spec requires on every VAPID-signed request,
# so a push service that needs to reach you about abuse has somewhere
# to go — any mailto: or https: URL you control.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret app/api/push/check checks on its Authorization header —
# without this, that route's URL would let anyone trigger a push run
# (and see whichever lines happen to be "reported" right now) with no
# auth at all. Generate your own, e.g. `openssl rand -hex 32`. Set as
# CRON_SECRET in Vercel too — vercel.json's cron config sends it
# automatically for the scheduled run; anyone/anything else calling this
# route needs to send it themselves as `Authorization: Bearer <value>`.
CRON_SECRET=
